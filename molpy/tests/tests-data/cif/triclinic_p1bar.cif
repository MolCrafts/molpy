# A triclinic P-1 test cell: every cell angle differs from 90 degrees, so a
# transposed cell matrix moves every atom.
data_triclinic
_cell_length_a    5.0
_cell_length_b    6.0
_cell_length_c    7.0
_cell_angle_alpha 80.0
_cell_angle_beta  95.0
_cell_angle_gamma 110.0
_symmetry_space_group_name_H-M 'P -1'
loop_
_symmetry_equiv_pos_as_xyz
x,y,z
-x,-y,-z
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
C1 C 0.10 0.20 0.30
O1 O 0.25 0.35 0.15
