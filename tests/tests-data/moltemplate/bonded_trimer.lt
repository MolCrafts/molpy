# Three bonded atoms with no declared angle: auto topology derives one angle.

Trimer {
  write_once("Data Masses") {
    @atom:C 12.011
  }

  write_once("In Settings") {
    pair_coeff @atom:C @atom:C lj/cut 0.066 3.5
    bond_coeff @bond:CC harmonic 268.0 1.529
  }

  write("Data Atoms") {
    $atom:c1 $mol:. @atom:C 0.0 0.0   0.0 0.0
    $atom:c2 $mol:. @atom:C 0.0 1.529 0.0 0.0
    $atom:c3 $mol:. @atom:C 0.0 2.0   1.4 0.0
  }

  write("Data Bonds") {
    $bond:b1 @bond:CC $atom:c1 $atom:c2
    $bond:b2 @bond:CC $atom:c2 $atom:c3
  }
}

t = new Trimer
